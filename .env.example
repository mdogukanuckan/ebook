# Copy to .env (git-ignored) and fill in. Used by docker-compose and when running the backend locally.

# PostgreSQL password (docker-compose db service and the backend datasource)
POSTGRES_PASSWORD=change-me

# JWT signing key: base64, at least 256 bits. Generate with: openssl rand -base64 32
JWT_SECRET_KEY=change-me

# Optional backend overrides
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ebookdb
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
# SPRING_JPA_SHOW_SQL=false
# SUBSCRIPTION_SELF_SERVICE_ENABLED=false
